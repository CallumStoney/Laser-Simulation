# Auto detect text files and perform LF normalization
* text=auto

# Large files tracked by Git LFS
*.mp4 filter=lfs diff=lfs merge=lfs -text
*.psd filter=lfs diff=lfs merge=lfs -text

# Ignore .meta and .obj files but do not enforce size limits
*.meta filter=lfs diff=lfs merge=lfs -text
*.obj filter=lfs diff=lfs merge=lfs -text
# Ignore Library and Temp files
Library/EditorInstance.json filter=lfs diff=lfs merge=lfs -text
Library/**/*.asset filter=lfs diff=lfs merge=lfs -text
Library/**/*.prefab filter=lfs diff=lfs merge=lfs -text

*.prefab text eol=crlf
